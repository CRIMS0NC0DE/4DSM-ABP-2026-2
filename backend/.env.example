PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Gere valores longos e aleatórios em produção: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-jwt
JWT_EXPIRES_IN=8h
QR_SECRET=troque-este-segredo-do-qr

# O QR troca a cada 10 s; o token aceita um pouco mais por causa da leitura.
QR_ROTATION_SECONDS=10
QR_TOKEN_TTL_SECONDS=30

# Fuso usado para conferir data e horário das autorizações.
APP_TIMEZONE=America/Sao_Paulo
CORS_ORIGIN=*

# Broker MQTT (docker compose -f docker-compose.dev.yml up mqtt). Sem MQTT_URL,
# os terminais recebem as decisões só pela consulta HTTP.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Endereço do broker por WebSocket, usado pelo simulador em /simulador
MQTT_WS_URL=ws://localhost:9001
