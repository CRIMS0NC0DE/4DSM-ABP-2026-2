generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid())
  nome         String
  email        String          @unique
  cpf          String          @unique
  senhaHash    String
  perfil       Perfil
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  eventos      AccessEvent[]
  autorizacoes Authorization[] @relation("AutorizacaoDoUsuario")
  tags         NfcTag[]
  celulares    NfcPhone[]
  /// Autorizações que a pessoa criou (o morador em "Meus visitantes").
  convites     Authorization[] @relation("AutorizacaoCriadaPor")
  comunicados  Comunicado[]

  @@map("users")
}

model NfcTag {
  id        String   @id @default(uuid())
  uid       String   @unique
  userId    String
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nfc_tags")
}

/// Celular Android que faz o papel de tag (HCE). O app gera um par de chaves
/// EC P-256 no Keystore do aparelho e só a chave pública vem para cá.
model NfcPhone {
  id           String   @id @default(uuid())
  userId       String
  nome         String
  chavePublica String   @unique
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("nfc_phones")
}

model Building {
  id        String @id @default(uuid())
  nome      String
  endereco  String
  portarias Gate[]

  @@map("buildings")
}

model Gate {
  id         String   @id @default(uuid())
  nome       String
  buildingId String
  portas     Door[]
  edificio   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("gates")
}

model Door {
  id       String        @id @default(uuid())
  nome     String
  gateId   String
  catracas AccessPoint[]
  portaria Gate          @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@map("doors")
}

model AccessPoint {
  id           String          @id @default(uuid())
  nome         String
  doorId       String
  latitude     Float
  longitude    Float
  raioMetros   Int             @default(100)
  eventos      AccessEvent[]
  porta        Door            @relation(fields: [doorId], references: [id], onDelete: Cascade)
  autorizacoes Authorization[]
  terminal     Terminal?

  @@map("access_points")
}

model Terminal {
  id            String        @id @default(uuid())
  nome          String
  accessPointId String        @unique
  chaveHash     String
  ultimoSinal   DateTime?
  latitude      Float?
  longitude     Float?
  eventos       AccessEvent[]
  catraca       AccessPoint   @relation(fields: [accessPointId], references: [id], onDelete: Cascade)

  @@map("terminals")
}

model Authorization {
  id             String            @id @default(uuid())
  userId         String
  accessPointId  String
  dataInicio     DateTime          @db.Date
  dataFim        DateTime          @db.Date
  horaInicio     String
  horaFim        String
  maxUsos        Int
  usosRealizados Int               @default(0)
  status         StatusAutorizacao @default(ATIVA)
  canceladaEm    DateTime?
  /// Quem criou: a equipe ou o morador que convidou o visitante. Null nas antigas.
  criadaPorId    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  eventos        AccessEvent[]
  catraca        AccessPoint       @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  user           User              @relation("AutorizacaoDoUsuario", fields: [userId], references: [id], onDelete: Cascade)
  criadaPor      User?             @relation("AutorizacaoCriadaPor", fields: [criadaPorId], references: [id], onDelete: SetNull)

  @@index([userId, accessPointId])
  @@index([criadaPorId])
  @@map("authorizations")
}

model AccessEvent {
  id              String          @id @default(uuid())
  metodo          MetodoAcesso
  resultado       ResultadoAcesso
  motivo          String?
  userId          String?
  accessPointId   String?
  terminalId      String?
  authorizationId String?
  credencial      String?
  latitude        Float?
  longitude       Float?
  distanciaMetros Float?
  createdAt       DateTime        @default(now())
  catraca         AccessPoint?    @relation(fields: [accessPointId], references: [id])
  autorizacao     Authorization?  @relation(fields: [authorizationId], references: [id])
  terminal        Terminal?       @relation(fields: [terminalId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("access_events")
}

/// Aviso do admin para quem usa o prédio.
model Comunicado {
  id        String   @id @default(uuid())
  titulo    String
  mensagem  String
  autorId   String?
  createdAt DateTime @default(now())
  autor     User?    @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("comunicados")
}

/// Regras do condomínio. Uma linha só (id = 1), criada pela migration.
model Configuracao {
  id                  Int      @id @default(1)
  nomeCondominio      String   @default("Condomínio")
  contatoPortaria     String   @default("Fale com a portaria pelo interfone.")
  moradorPodeConvidar Boolean  @default(true)
  visitanteMaxUsos    Int      @default(2)
  visitanteDiasMax    Int      @default(7)
  updatedAt           DateTime @default(now()) @updatedAt

  @@map("configuracoes")
}

model UsedQrToken {
  jti    String   @id
  usedAt DateTime @default(now())

  @@map("used_qr_tokens")
}

enum Perfil {
  ADMIN
  CONTROLADOR_ACESSO
  CONDOMINO
  VISITANTE
}

enum StatusAutorizacao {
  ATIVA
  CANCELADA
}

enum MetodoAcesso {
  QR
  NFC
  CELULAR
}

enum ResultadoAcesso {
  LIBERADO
  NEGADO
}
