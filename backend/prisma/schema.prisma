generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid())
  nome         String
  email        String          @unique
  cpf          String          @unique
  senhaHash    String
  perfil       Perfil
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  eventos      AccessEvent[]
  autorizacoes Authorization[]
  tags         NfcTag[]

  @@map("users")
}

model NfcTag {
  id        String   @id @default(uuid())
  uid       String   @unique
  userId    String
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nfc_tags")
}

model Building {
  id        String @id @default(uuid())
  nome      String
  endereco  String
  portarias Gate[]

  @@map("buildings")
}

model Gate {
  id         String   @id @default(uuid())
  nome       String
  buildingId String
  portas     Door[]
  edificio   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("gates")
}

model Door {
  id       String        @id @default(uuid())
  nome     String
  gateId   String
  catracas AccessPoint[]
  portaria Gate          @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@map("doors")
}

model AccessPoint {
  id           String          @id @default(uuid())
  nome         String
  doorId       String
  latitude     Float
  longitude    Float
  raioMetros   Int             @default(100)
  eventos      AccessEvent[]
  porta        Door            @relation(fields: [doorId], references: [id], onDelete: Cascade)
  autorizacoes Authorization[]
  terminal     Terminal?

  @@map("access_points")
}

model Terminal {
  id            String        @id @default(uuid())
  nome          String
  accessPointId String        @unique
  chaveHash     String
  ultimoSinal   DateTime?
  latitude      Float?
  longitude     Float?
  eventos       AccessEvent[]
  catraca       AccessPoint   @relation(fields: [accessPointId], references: [id], onDelete: Cascade)

  @@map("terminals")
}

model Authorization {
  id             String            @id @default(uuid())
  userId         String
  accessPointId  String
  dataInicio     DateTime          @db.Date
  dataFim        DateTime          @db.Date
  horaInicio     String
  horaFim        String
  maxUsos        Int
  usosRealizados Int               @default(0)
  status         StatusAutorizacao @default(ATIVA)
  canceladaEm    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  eventos        AccessEvent[]
  catraca        AccessPoint       @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, accessPointId])
  @@map("authorizations")
}

model AccessEvent {
  id              String          @id @default(uuid())
  metodo          MetodoAcesso
  resultado       ResultadoAcesso
  motivo          String?
  userId          String?
  accessPointId   String?
  terminalId      String?
  authorizationId String?
  credencial      String?
  latitude        Float?
  longitude       Float?
  distanciaMetros Float?
  createdAt       DateTime        @default(now())
  catraca         AccessPoint?    @relation(fields: [accessPointId], references: [id])
  autorizacao     Authorization?  @relation(fields: [authorizationId], references: [id])
  terminal        Terminal?       @relation(fields: [terminalId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("access_events")
}

model UsedQrToken {
  jti    String   @id
  usedAt DateTime @default(now())

  @@map("used_qr_tokens")
}

enum Perfil {
  ADMIN
  CONTROLADOR_ACESSO
  CONDOMINO
  VISITANTE
}

enum StatusAutorizacao {
  ATIVA
  CANCELADA
}

enum MetodoAcesso {
  QR
  NFC
}

enum ResultadoAcesso {
  LIBERADO
  NEGADO
}
